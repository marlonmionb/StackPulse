generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model SourceItem {
  id                            String                   @id @default(cuid())
  title                         String
  url                           String             @unique
  canonicalUrl                  String?                  @unique
  source                        String
  contentType                   ContentType              @default(UNKNOWN)
  summary                       String?
  metadataEnrichmentStatus      MetadataEnrichmentStatus @default(PENDING)
  metadataEnrichmentAttemptedAt DateTime?
  author                        String?
  publishedAt                   DateTime?
  technicalRelevant             Boolean?
  technicalRelevanceScore       Int?
  technicalCategory             TechnicalCategory?
  technicalRelevanceReason      String?
  technicalRelevanceEvaluatedAt DateTime?
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt

  @@index([technicalRelevanceEvaluatedAt, contentType])
  @@index([technicalRelevant, publishedAt])
  @@index([metadataEnrichmentStatus, contentType])
}

model Topic {
  id          String      @id @default(cuid())
  title       String
  description String?
  score       Float?
  status      TopicStatus @default(DISCOVERED)
  posts       Post[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Post {
  id          String     @id @default(cuid())
  content     String
  status      PostStatus @default(DRAFT)
  topicId     String?
  topic       Topic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([topicId])
}

model AiUsage {
  id               String        @id @default(cuid())
  feature          String
  model            String
  inputTokens      Int           @default(0)
  outputTokens     Int           @default(0)
  estimatedCostUsd Float?
  durationMs       Int
  status           AiUsageStatus
  createdAt        DateTime      @default(now())

  @@index([createdAt, status])
}

enum TopicStatus {
  DISCOVERED
  SELECTED
  ARCHIVED
}

enum PostStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum AiUsageStatus {
  SUCCESS
  FAILURE
}

enum ContentType {
  ARTICLE
  VIDEO
  UNKNOWN
}

enum MetadataEnrichmentStatus {
  PENDING
  ENRICHED
  NO_METADATA
  FAILED
}

enum TechnicalCategory {
  FRONTEND
  BACKEND
  FULLSTACK
  DATABASE
  CLOUD
  DEVOPS
  ARCHITECTURE
  AI
  SECURITY
  PROGRAMMING_LANGUAGE
  DEVELOPER_TOOLING
  SOFTWARE_ENGINEERING
  OTHER_TECH
  NON_SOFTWARE
}
