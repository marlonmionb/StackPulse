generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model SourceItem {
  id                            String                   @id @default(cuid())
  title                         String
  url                           String             @unique
  canonicalUrl                  String?                  @unique
  source                        String
  contentType                   ContentType              @default(UNKNOWN)
  summary                       String?
  metadataEnrichmentStatus      MetadataEnrichmentStatus @default(PENDING)
  metadataEnrichmentAttemptedAt DateTime?
  author                        String?
  publishedAt                   DateTime?
  technicalRelevant             Boolean?
  technicalRelevanceScore       Int?
  technicalCategory             TechnicalCategory?
  technicalRelevanceReason      String?
  technicalRelevanceEvaluatedAt DateTime?
  contentKind                   ContentKind?
  contentKindConfidence         ContentKindConfidence?
  contentKindReason             String?
  contentKindEvaluatedAt        DateTime?
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  topics                        TopicSourceItem[]

  @@index([technicalRelevanceEvaluatedAt, contentType])
  @@index([technicalRelevant, publishedAt])
  @@index([contentKindEvaluatedAt, contentType])
  @@index([contentKind, publishedAt])
  @@index([metadataEnrichmentStatus, contentType])
}

model Topic {
  id                    String            @id @default(cuid())
  title                 String
  description           String?
  score                 Float?
  profileRelevanceScore Float?
  technicalDepthScore   Float?
  freshnessScore        Float?
  contentPotentialScore Float?
  rankingReason         String?
  discoverySignature    String?           @unique
  status                TopicStatus       @default(DISCOVERED)
  discoveredAt          DateTime           @default(now())
  sourceItems           TopicSourceItem[]
  researches            TopicResearch[]
  posts                 Post[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

model TopicSourceItem {
  topicId      String
  sourceItemId String
  topic        Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  sourceItem   SourceItem @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([topicId, sourceItemId])
  @@index([sourceItemId])
}

model Post {
  id          String     @id @default(cuid())
  content     String
  status      PostStatus @default(DRAFT)
  topicId     String?
  topic       Topic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([topicId])
}

model AiUsage {
  id               String        @id @default(cuid())
  feature          String
  model            String
  inputTokens      Int           @default(0)
  outputTokens     Int           @default(0)
  reasoningTokens  Int           @default(0)
  webSearchCalls   Int           @default(0)
  estimatedTokenCostUsd Float?
  estimatedToolCostUsd  Float?
  estimatedCostUsd Float?
  durationMs       Int
  status           AiUsageStatus
  createdAt        DateTime      @default(now())

  @@index([createdAt, status])
}

model TopicResearch {
  id                    String                @id @default(cuid())
  topicId               String
  topic                 Topic                 @relation(fields: [topicId], references: [id], onDelete: Cascade)
  summary               String
  whyItMatters          String
  keyFindings           Json
  technicalDetails      Json
  tradeoffs              Json
  practicalImplications Json
  openQuestions         Json
  limitations           Json
  model                  String
  webSearchCalls         Int                   @default(0)
  inputTokens            Int                   @default(0)
  outputTokens           Int                   @default(0)
  reasoningTokens       Int                   @default(0)
  estimatedTokenCostUsd Float?
  estimatedToolCostUsd  Float?
  estimatedTotalCostUsd Float?
  researchedAt          DateTime               @default(now())
  createdAt             DateTime               @default(now())
  sources               TopicResearchSource[]

  @@index([topicId, researchedAt])
}

model TopicResearchSource {
  id           String                  @id @default(cuid())
  researchId   String
  research     TopicResearch           @relation(fields: [researchId], references: [id], onDelete: Cascade)
  evidenceId   String
  title        String
  url          String
  canonicalUrl String
  publisher    String?
  domain       String
  publishedAt  DateTime?
  type         TopicResearchSourceType
  createdAt    DateTime                @default(now())

  @@unique([researchId, evidenceId])
  @@unique([researchId, canonicalUrl])
  @@index([researchId])
}

enum TopicStatus {
  DISCOVERED
  SELECTED
  RESEARCHED
  ARCHIVED
}

enum TopicResearchSourceType {
  PRIMARY
  SECONDARY
}

enum PostStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum AiUsageStatus {
  SUCCESS
  FAILURE
}

enum ContentType {
  ARTICLE
  VIDEO
  UNKNOWN
}

enum ContentKind {
  TECHNICAL_ARTICLE
  TECHNICAL_NEWS
  OFFICIAL_TECHNICAL
  RESEARCH
  REPOSITORY
  PRODUCT_PAGE
  DISCUSSION
  OTHER
}

enum ContentKindConfidence {
  HIGH
  MEDIUM
  LOW
}

enum MetadataEnrichmentStatus {
  PENDING
  ENRICHED
  NO_METADATA
  FAILED
}

enum TechnicalCategory {
  FRONTEND
  BACKEND
  FULLSTACK
  DATABASE
  CLOUD
  DEVOPS
  ARCHITECTURE
  AI
  SECURITY
  PROGRAMMING_LANGUAGE
  DEVELOPER_TOOLING
  SOFTWARE_ENGINEERING
  OTHER_TECH
  NON_SOFTWARE
}
